# Copiá este archivo como `.env` (en esta misma carpeta, apps/api) y completalo.
# `.env` NO se sube al repositorio (está en .gitignore) y las credenciales NUNCA van en el frontend.

# --- Dónde se guardan las partituras ---
# mongo  → MongoDB Atlas (el valor por defecto)
# memory → en la memoria del servidor, sin base de datos: sirve para probar la API; se pierde al reiniciarla
STORAGE=mongo

# --- MongoDB Atlas ---
# Cadena de conexión completa de Atlas (Database > Connect > Drivers), con el usuario y la contraseña
# del usuario de base de datos (no la cuenta de Atlas). Si la contraseña tiene caracteres especiales
# (@ : / ? # %), codificalos (por ejemplo @ → %40).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@TU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Nombre de la base de datos donde se crea la colección "scores".
MONGODB_DB_NAME=partituras

# --- Servidor ---
PORT=3001
